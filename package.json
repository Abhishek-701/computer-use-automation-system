{
  "name": "computer-use-automation-system",
  "version": "0.1.0",
  "private": true,
  "description": "Discover-once, replay-many computer-use automation for legacy back-office UIs.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "target-app": "tsx target-app/server.ts",
    "target-app:tenant-b": "tsx target-app/server.ts --port 3001 --member-id-label \"Member Number\"",
    "discover": "tsx src/cli/index.ts discover",
    "replay": "tsx src/cli/index.ts replay",
    "show": "tsx src/cli/index.ts show",
    "catalog": "tsx src/cli/index.ts catalog",
    "stability": "tsx src/cli/index.ts stability",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "express": "^4.21.0",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
