# Copy to .env and fill in. Never commit .env.
# Only `npm run discover` needs this key — replay, show, catalog, stability,
# and `npm test` all run with no key and no network access.
ANTHROPIC_API_KEY=

# Target app ports (defaults shown; override if occupied)
TARGET_APP_PORT=3000
TARGET_APP_TENANT_B_PORT=3001

# Escalation HTTP server port
ESCALATION_SERVER_PORT=3100
