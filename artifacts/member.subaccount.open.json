{
  "schema_version": "1.0.0",
  "capability": {
    "id": "member.subaccount.open",
    "version": "1.0.0",
    "name": "Open a member sub-account",
    "description": "Given a member ID, account type, and initial deposit, opens a new sub-account and returns the generated account number. Mutating and irreversible: the final confirmation click requires human approval.",
    "status": "draft",
    "risk_class": "mutating"
  },
  "target": {
    "app_id": "target-app-hostile-core-banking",
    "surface": "web",
    "entry_point": "/members/search",
    "policy_ref": "src/policy/policy.default.json"
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "pattern": "^[0-9]{5}$",
      "redact": true,
      "example": "10001"
    },
    {
      "name": "account_type",
      "type": "string",
      "required": true,
      "redact": false,
      "example": "savings"
    },
    {
      "name": "initial_deposit",
      "type": "string",
      "required": true,
      "redact": false,
      "example": "500"
